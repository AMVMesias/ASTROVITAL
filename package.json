{
  "name": "nasa-health",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.backend.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/local.ts migrate",
    "db:seed": "node --import tsx scripts/local.ts seed",
    "device:provision": "node --import tsx scripts/local.ts device",
    "device:revoke": "node --import tsx scripts/local.ts revoke-device",
    "demo:simulate": "node --import tsx scripts/local.ts simulate",
    "test:production": "node --import tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swagger-ui-dist": "^5.35.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
