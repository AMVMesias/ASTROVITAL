NEXT_PUBLIC_API_URL=/api
# Operación local; no usar SQLite persistente en Vercel.
APP_MODE=local
SQLITE_PATH=data/local/nasa-health.sqlite
ADMIN_USERNAME=admin
# Aprovisionar localmente, sin credenciales por defecto.
ADMIN_PASSWORD=
# En HTTPS activar; en LAN HTTP de demo dejar false.
COOKIE_SECURE=false
# Opcional: origen exacto autorizado, por ejemplo http://192.168.1.10:3000
APP_ORIGIN=
DEVICE_USERNAME=
DEVICE_ID=esp32-demo
DEVICE_TOKEN=
DEMO_USERNAME=
DEMO_RUN_ID=stable-variation-v1

# Sincronización (equipo local y receptor)
NASA_SYNC_ENDPOINT=
NASA_SYNC_TOKEN=
# Solo receptor PostgreSQL
NASA_SYNC_MISSION_ID=
NASA_SYNC_DATABASE_URL=
